---
import { getCollection } from "astro:content";
import BookLayout from "../layouts/BookLayout.astro";

export async function getStaticPaths() {
  const chapters = await getCollection("chapters");
  return chapters.map((c) => ({ params: { slug: c.id.replace(/\.md$/, "") } }));
}

const { slug } = Astro.params;
const all = await getCollection("chapters");
all.sort((a, b) => a.data.order - b.data.order);

const chapter = all.find((c) => c.id.replace(/\.md$/, "") === slug);
if (!chapter) return Astro.redirect("/llox/");

const { Content } = await chapter.render();
const data = chapter.data;
const isPart = data.kind === "part";
const base = import.meta.env.BASE_URL;

// Find parent part for chapters
const part = data.kind === "chapter"
  ? (() => {
      const intro = all.find((c) => c.data.kind === "part" && c.data.partNumber === data.part);
      if (!intro) return undefined;
      return {
        number: intro.data.partNumber!,
        slug: intro.id.replace(/\.md$/, ""),
        chapters: all.filter((c) => c.data.kind === "chapter" && c.data.part === intro.data.partNumber),
      };
    })()
  : isPart
    ? (() => {
        const chapters = all.filter((c) => c.data.kind === "chapter" && c.data.part === data.partNumber);
        return { number: data.partNumber!, slug: slug!, chapters };
      })()
    : undefined;
---

<BookLayout title={data.title} slug={slug!}>
  <h1 class:list={{ part: isPart }}>
    {isPart ? `Part ${data.partNumber}: ${data.title}` : data.title}
  </h1>

  {
    isPart && part ? (
      <div class="part-intro">
        <Content />
        <hr style="margin: 16px 0; border: none; border-top: 1px solid var(--border);" />
        <p>This part covers {part.chapters.length} chapters:</p>
        <ol>
          {part.chapters.map((ch) => (
            <li><a href={`${base}${ch.id.replace(/\.md$/, "")}`}>{ch.data.title}</a></li>
          ))}
        </ol>
      </div>
    ) : (
      <div class="chapter-content">
        <Content />
      </div>
    )
  }

  <p style="margin-top: 24px;"><a href={`${base}`}>&larr; Back to Table of Contents</a></p>
</BookLayout>
